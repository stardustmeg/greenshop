    "@types/sinon": "^17.0.3",
    "autoprefixer": "^10.4.19",
    "hammerjs": "^2.0.8",
    "isomorphic-fetch": "^3.0.0",
    "js-cookie": "^3.0.5",
    "materialize-css": "^1.0.0-rc.2",
    "modern-normalize": "^3.0.1",
    "msw": "^2.3.1",
    "nouislider": "^15.7.1",
    "plop": "^4.0.1",
